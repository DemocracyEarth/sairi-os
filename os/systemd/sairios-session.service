# SairiOS kiosk session. This is a SYSTEM unit, not a user unit.
#
# Install to /etc/systemd/system/sairios-session.service
#
#   systemctl daemon-reload
#   systemctl enable sairios-session.service
#   systemctl set-default graphical.target
#
# It is a system unit for exactly two reasons: it has to claim a virtual terminal, and it
# has to open a login session through PAM so that the user `sairi` gets a seat, an
# XDG_RUNTIME_DIR, and a running systemd user manager. It drops to `sairi` immediately
# and nothing it starts runs as root.
#
# It does NOT start the SairiOS services. Those are user units owned by `sairi` and are
# started by that user's systemd instance, which runs from boot because `sairi` has
# lingering enabled (`loginctl enable-linger sairi`). This unit only puts a screen in
# front of them.

[Unit]
Description=SairiOS kiosk session (cage + cog)
Documentation=file:/opt/sairios/os/session/README.md
# Wait until user logins are permitted, otherwise PAMName=login below fails.
After=systemd-user-sessions.service
# Start the shell first. The session script waits for 127.0.0.1:7800 with a bounded
# timeout and shows a legible banner if it never answers, so this is not required for
# correctness - but without it a cold boot spends that wait budget racing the shell
# instead of using it for a genuine fault. Wants= rather than Requires=: if the shell
# is broken, the session should still come up and say so on the screen.
Wants=sairios-shell.service
After=sairios-shell.service
# seatd hands out the DRM and input devices. cage will fail without a seat.
Requires=seatd.service
After=seatd.service
# Take tty1 away from the text getty. Without Conflicts= the two fight over the VT and
# the display flickers between them.
Conflicts=getty@tty1.service
After=getty@tty1.service
# Let the boot splash release the console first.
After=plymouth-quit-wait.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=sairi
Group=sairi
# video and render: DRM master and GPU render nodes. input: /dev/input/event*.
# seat: seatd's control socket group on Debian.
SupplementaryGroups=video render input seat

# Open a real PAM session. This is what causes pam_systemd to create /run/user/<uid>,
# register the seat with logind, and make the user's systemd instance available. Without
# it, XDG_RUNTIME_DIR is unset and cage cannot create a Wayland socket.
PAMName=login

# Own tty1 outright.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
# Session output goes to the journal, not to the VT, so that cage owns the screen. The
# launcher writes its own failure banner directly to /dev/tty1 when it gives up, because
# a black screen with the reason buried in the journal is the worst possible outcome.
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=sairios
Environment=XDG_CURRENT_DESKTOP=SairiOS
# The launcher waits on this before it starts cog.
# The machine boots into Sairi OS — the context-native surface — not the v0
# desktop. Same shell, same port; the hash decides which one mounts.
#
# This line overrides the default in the launcher script, so BOTH have to agree.
# Changing only the script does nothing, which cost a delivery cycle to notice.
#
# The v0 desktop is still there at http://127.0.0.1:7800/ and a drop-in or
# /etc/sairios/session.env switches the machine back without a rebuild.
Environment=SAIRIOS_SHELL_URL=http://127.0.0.1:7800/#/os
Environment=SAIRIOS_SHELL_WAIT_SECONDS=120
EnvironmentFile=-/etc/sairios/session.env

# A thin shim installed by cloud-init that execs /opt/sairios/os/session/sairios-session.sh
# when the product tree is present, and prints a legible banner on the VT when it is not.
ExecStart=/usr/local/bin/sairios-session

Restart=on-failure
# Deliberately slow. A session that crash-loops at 1s intervals makes the machine
# unusable and unreadable; 5s leaves time to switch to another VT and look at the journal.
RestartSec=5
TimeoutStopSec=20
# Kill the whole session, not just cage, so a wedged cog does not survive a restart.
KillMode=control-group

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
# This unit is much less confined than the four service units, and that is not an
# oversight: a Wayland compositor needs DRM devices, input devices, GPU render nodes and
# the seat manager socket. The compensating control is that everything with real reach
# (files, processes, network) goes through the permission broker, which this unit does
# not talk to.
NoNewPrivileges=yes
# PrivateDevices, ProtectHome and ProtectSystem=strict are NOT set. cage needs /dev/dri
# and /dev/input; cog needs a writable WebKit cache under the user's home.
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# RestrictRealtime is NOT set. PipeWire's audio threads request SCHED_FIFO through
# rtkit; denying realtime here produces audio glitches once audio is wired up.
# MemoryDenyWriteExecute is NOT set. WebKit's JavaScript JIT needs write-then-execute
# pages, exactly as Node does.
# SystemCallFilter is NOT set. A compositor plus a browser engine touch a much wider
# syscall surface than @system-service covers, and a too-narrow filter here presents as
# an unexplained black screen rather than as a legible error.

[Install]
WantedBy=graphical.target
