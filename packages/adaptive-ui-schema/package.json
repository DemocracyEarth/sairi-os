{
  "name": "@sairios/adaptive-ui-schema",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/sairi-ui.schema.json": "./src/schema/sairi-ui.schema.json"
  },
  "scripts": {
    "build": "node scripts/build-validator.mjs && tsc --build && mkdir -p dist/generated && cp src/generated/sairi-ui-validator.js src/generated/sairi-ui-validator.d.ts dist/generated/",
    "build:validator": "node scripts/build-validator.mjs",
    "check:validator": "node scripts/build-validator.mjs --check",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sairios/shared": "*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
