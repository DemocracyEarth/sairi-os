# SairiOS local development configuration.
#
# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# SairiOS boots fully in `mock` mode with NO credentials of any kind.
# Only set provider credentials when you explicitly opt into `openclaw` mode.

# ---------------------------------------------------------------------------
# Agent provider
# ---------------------------------------------------------------------------
# mock     — deterministic in-process provider. No network, no API key. Default.
# openclaw — connect to a locally running OpenClaw Gateway (see docs/OPENCLAW.md).
SAIRIOS_AGENT_PROVIDER=mock

# ---------------------------------------------------------------------------
# Model configuration
# ---------------------------------------------------------------------------
# Preferred path: leave these EMPTY and let OpenClaw own provider credentials
# via its own onboarding (`openclaw onboard`). These variables exist only for
# environment-based local development where OpenClaw reads them from its env.
#
# SairiOS itself never reads SAIRIOS_LLM_API_KEY to make a provider call; it is
# passed through to the OpenClaw process when you start it from `make dev`.
SAIRIOS_LLM_PROVIDER=
SAIRIOS_LLM_MODEL=
SAIRIOS_LLM_API_KEY=

# ---------------------------------------------------------------------------
# OpenClaw Gateway
# ---------------------------------------------------------------------------
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Pinned upstream version. See openclaw/config/version.json — keep in sync.
OPENCLAW_VERSION=

# ---------------------------------------------------------------------------
# Service bind addresses (loopback only by default — do not expose publicly)
# ---------------------------------------------------------------------------
SAIRIOS_BIND_HOST=127.0.0.1
SAIRIOS_CONTEXT_SERVICE_PORT=7801
SAIRIOS_AGENT_BRIDGE_PORT=7802
SAIRIOS_PERMISSION_BROKER_PORT=7803
SAIRIOS_SHELL_PORT=7800

# ---------------------------------------------------------------------------
# Local persistence
# ---------------------------------------------------------------------------
# Directory for the context database, audit log and sandbox workspace.
SAIRIOS_DATA_DIR=./var
# sqlite — node:sqlite (Node >= 22.5 with --experimental-sqlite, >= 23.4 native)
# json   — portable single-file JSON store, no native deps
# auto   — sqlite when available, otherwise json
SAIRIOS_STORE_DRIVER=auto

# ---------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------
# The ONLY directory agent-proposed file actions may ever touch.
SAIRIOS_SANDBOX_DIR=./var/sandbox

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
SAIRIOS_LOG_LEVEL=info
